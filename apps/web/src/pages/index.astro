---
import Base from "../layouts/Base.astro";
import SectionAnchor from "../components/SectionAnchor.astro";
import RedTicker from "../components/RedTicker.astro";
import PhoneMock from "../components/PhoneMock.astro";
import Sparkline from "../components/Sparkline.astro";
---

<Base>
  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 hero-grid pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-[640px] bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,var(--brand-glow-soft),transparent_70%)] pointer-events-none" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-24 pb-20 sm:pb-28">
      <div class="grid lg:grid-cols-[1.25fr_1fr] gap-10 lg:gap-16 items-center">

        <div class="space-y-7 sm:space-y-9">
          <!-- Status chip -->
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full border border-border-subtle bg-surface-2 font-mono text-[11px] text-text-secondary tracking-wide">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-success pulse-dot"></span>
            <span class="text-text-muted">v</span>
            <span class="text-text tabular">0.0.1</span>
            <span class="text-text-muted">·</span>
            <span>shipping to app stores</span>
          </div>

          <h1 class="text-[40px] sm:text-[60px] lg:text-[76px] leading-[0.95] font-semibold tracking-tight">
            Your SigNoz,
            <br class="hidden sm:block" />
            <span class="relative inline-block">
              <span class="relative z-10 bg-clip-text text-transparent bg-[linear-gradient(180deg,var(--text)_0%,var(--text-secondary)_120%)]">in your pocket</span>
              <span class="absolute -inset-x-1 bottom-0.5 h-[18px] sm:h-[22px] bg-brand/40 blur-[14px] -z-0" aria-hidden="true"></span>
            </span>
            <span class="text-brand">.</span>
          </h1>

          <p class="max-w-xl text-[17px] sm:text-[19px] leading-relaxed text-text-secondary">
            RED metrics, traces, and logs from any SigNoz instance,
            on the phone in your hand. Bring your own SigNoz.
            Your data never leaves your stack.
          </p>

          <RedTicker />

          <div class="flex items-center gap-2 sm:gap-3">
            <a
              href="https://github.com/eknuth/sigpocket"
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 px-4 sm:px-5 h-12 rounded-xl bg-brand text-white font-medium text-[14px] sm:text-[15px] brand-glow hover:bg-brand-hi transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.5 3.16-1.18 3.16-1.18.63 1.58.24 2.75.11 3.04.74.8 1.18 1.82 1.18 3.08 0 4.42-2.69 5.39-5.25 5.67.41.35.78 1.05.78 2.12v3.14c0 .31.2.67.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/>
              </svg>
              Star on GitHub
            </a>

            <span class="inline-flex items-center gap-2 px-3 sm:px-4 h-12 rounded-xl border border-border bg-surface-2 text-text-secondary text-[12px] sm:text-[13px] whitespace-nowrap">
              <svg class="w-4 h-4 text-text-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3.6 1.6a1 1 0 0 0-1 1v18.8a1 1 0 0 0 1 1c.18 0 .35-.05.5-.13l11-9.4-11-9.4a1 1 0 0 0-.5-.27zm12.7 8.1L19.9 8a1 1 0 0 1 0 1.7l-3.6 1.7-2.9-2.5 2.9-1.2zm-1.7 2.6L13 16l-7-6 1.6-.5 7 3.1z"/>
              </svg>
              <span class="font-mono text-[11px] sm:text-[12px] uppercase tracking-widest text-text-muted">soon</span>
              <span>Play Store</span>
            </span>

            <span class="inline-flex items-center gap-2 px-3 sm:px-4 h-12 rounded-xl border border-border bg-surface-2 text-text-secondary text-[12px] sm:text-[13px] whitespace-nowrap">
              <svg class="w-4 h-4 text-text-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.152 6.896c-.548 0-1.711-.516-2.861-.516-1.514 0-2.89 1.054-3.67 2.433-1.55 2.767-.394 6.871 1.116 9.105.738 1.083 1.63 2.301 2.793 2.301 1.116 0 1.539-.754 2.883-.754 1.346 0 1.725.754 2.894.754 1.153 0 1.933-1.083 2.67-2.301.845-1.24 1.205-2.452 1.225-2.514-.026-.011-2.362-.914-2.385-3.61-.025-2.257 1.848-3.336 1.935-3.393-1.047-1.554-2.678-1.705-3.254-1.705-1.393 0-2.733.914-2.733.914-.002 0-.613-.914-2.613-.914zm3.012-4.148c.613-.745 1.018-1.777.9-2.748-.829.034-1.83.564-2.422 1.258-.533.619-.997 1.673-.873 2.622.923.072 1.782-.387 2.395-1.132z"/>
              </svg>
              <span class="font-mono text-[11px] sm:text-[12px] uppercase tracking-widest text-text-muted">soon</span>
              <span>App Store</span>
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[12px] text-text-muted font-mono">
            <span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-text-muted"></span>apache 2.0</span>
            <span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-text-muted"></span>byo signoz</span>
            <span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-text-muted"></span>no accounts</span>
            <span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-text-muted"></span>no tracking</span>
          </div>
        </div>

        <div class="relative flex justify-center lg:justify-end">
          <PhoneMock />
        </div>
      </div>
    </div>

    <!-- bottom fade so grid doesn't bleed into next section -->
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-[var(--bg)] pointer-events-none" aria-hidden="true"></div>
  </section>

  <!-- ─── PITCH (asymmetric, NOT a 3-col grid) ─────────────── -->
  <section class="relative mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-24">
    <SectionAnchor id="pitch" label="The pitch" index="01" />

    <div class="grid gap-x-12 gap-y-12 sm:grid-cols-12">
      <div class="sm:col-span-7 sm:col-start-1 reveal">
        <div class="font-mono text-[11px] tracking-widest uppercase text-brand mb-3">— 01</div>
        <h2 class="text-[28px] sm:text-[38px] leading-[1.05] font-semibold tracking-tight">
          Bring your own SigNoz.
        </h2>
        <p class="mt-3 text-text-secondary text-[16px] sm:text-[17px] leading-relaxed max-w-xl">
          Cloud or self-hosted. Connect with a URL and API key,
          then watch the same data you'd see on a desktop dashboard.
          We are not a hosted service. We are a client for yours.
        </p>
      </div>

      <div class="sm:col-span-5 sm:col-start-8 sm:mt-24 reveal">
        <div class="font-mono text-[11px] tracking-widest uppercase text-brand mb-3">— 02</div>
        <h2 class="text-[24px] sm:text-[30px] leading-[1.1] font-semibold tracking-tight">
          Built for glance latency.
        </h2>
        <p class="mt-3 text-text-secondary text-[15px] leading-relaxed">
          Not for dashboards. RED metrics, traces, and recent errors,
          surfaced in two taps from your lock screen.
        </p>
      </div>

      <div class="sm:col-span-8 sm:col-start-3 reveal">
        <div class="font-mono text-[11px] tracking-widest uppercase text-brand mb-3">— 03</div>
        <h2 class="text-[26px] sm:text-[34px] leading-[1.05] font-semibold tracking-tight">
          Your data stays with your instance. Always.
        </h2>
        <p class="mt-3 text-text-secondary text-[15px] leading-relaxed max-w-2xl">
          API keys live in your device keychain.
          The app's own telemetry goes to <em class="text-text not-italic font-mono text-[13px] bg-surface-2 px-1.5 py-0.5 rounded-md border border-border-subtle">your</em> SigNoz, not ours.
          There is no "ours."
        </p>
      </div>
    </div>
  </section>

  <!-- ─── BENTO FEATURES ───────────────────────────────────── -->
  <section class="relative mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-20">
    <SectionAnchor id="features" label="Features" index="02 · six tiles" />

    <div class="grid gap-3 grid-cols-1 sm:grid-cols-6 sm:grid-rows-[auto_auto_auto] auto-rows-min">
      <!-- LARGE: services overview -->
      <article class="reveal sm:col-span-4 sm:row-span-2 rounded-2xl border border-border-subtle bg-surface-2 p-6 sm:p-8 relative overflow-hidden">
        <div class="flex items-center gap-2 font-mono text-[11px] tracking-widest uppercase text-text-muted mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
          services
        </div>
        <h3 class="text-[22px] sm:text-[26px] font-semibold tracking-tight">
          RED at a glance.
        </h3>
        <p class="mt-2 text-text-secondary text-[14px] leading-relaxed max-w-md">
          Sortable list of every service with its rate, error percentage, and p95 latency.
          Critical services glow red. Healthy ones stay quiet.
        </p>

        <!-- Mini service rows preview -->
        <div class="mt-7 space-y-2">
          {[
            { name: "api-gateway",     rate: "1.28k", p95: "184ms",  err: "0.04%", status: "ok"   },
            { name: "checkout-svc",    rate: "412",   p95: "521ms",  err: "1.21%", status: "warn" },
            { name: "payments-worker", rate: "88",    p95: "2.1s",   err: "6.4%",  status: "crit" },
            { name: "user-service",    rate: "2.04k", p95: "61ms",   err: "0.01%", status: "ok"   },
          ].map((r) => (
            <div class={`flex items-center gap-3 p-3 rounded-lg border bg-surface ${r.status === "crit" ? "border-danger/50" : "border-border-subtle"}`}>
              <span class={`w-2 h-2 rounded-full ${r.status === "ok" ? "bg-success" : r.status === "warn" ? "bg-warning" : "bg-danger"}`}></span>
              <span class="text-[13px] font-medium flex-1 truncate">{r.name}</span>
              <span class="font-mono text-[11px] tabular text-text-muted hidden sm:inline">{r.rate}<span class="text-text-muted/60">/min</span></span>
              <span class={`font-mono text-[11px] tabular ${r.status === "crit" ? "text-danger" : "text-text"}`}>{r.p95}</span>
              <span class={`font-mono text-[10px] tabular ${r.status === "ok" ? "text-success" : r.status === "warn" ? "text-warning" : "text-danger"}`}>{r.err}</span>
            </div>
          ))}
        </div>
      </article>

      <!-- MEDIUM: p95 latency chart -->
      <article class="reveal sm:col-span-2 rounded-2xl border border-border-subtle bg-surface-2 p-6 relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
          <div class="font-mono text-[11px] tracking-widest uppercase text-text-muted">p95 latency</div>
          <div class="font-mono text-[10px] tabular text-text-muted flex items-center gap-1">
            <span class="px-1.5 py-0.5 rounded bg-surface-3 text-text">1h</span>
            <span>6h</span>
            <span>24h</span>
          </div>
        </div>
        <div class="mt-1">
          <div class="font-mono text-[26px] tabular font-medium tracking-tight">184<span class="text-text-muted text-[16px]">ms</span></div>
          <div class="font-mono text-[11px] tabular text-success flex items-center gap-1">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 15 6-6 6 6"/></svg>
            -12ms · last hour
          </div>
        </div>
        <div class="mt-4 h-20 -mx-2">
          <Sparkline />
        </div>
        <p class="mt-2 text-[12px] text-text-muted leading-snug">
          Skia-rendered line charts. 1h / 6h / 24h.
        </p>
      </article>

      <!-- MEDIUM: traces -->
      <article class="reveal sm:col-span-3 rounded-2xl border border-border-subtle bg-surface-2 p-6 relative overflow-hidden">
        <div class="flex items-center gap-2 font-mono text-[11px] tracking-widest uppercase text-text-muted mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
          traces
        </div>
        <h3 class="text-[18px] font-semibold tracking-tight mb-1">Search + waterfall.</h3>
        <p class="text-text-secondary text-[13px] leading-relaxed max-w-xs">
          Find a slow trace, see every span. Trace IDs are searchable and shareable.
        </p>

        <!-- Mini waterfall -->
        <div class="mt-5 space-y-1.5 font-mono text-[10px]">
          {[
            { label: "POST /checkout",   w: 92, off: 0,  c: "brand"   },
            { label: "  db.query users", w: 18, off: 6,  c: "muted"   },
            { label: "  http payments",  w: 60, off: 26, c: "warning" },
            { label: "    db.lock",      w: 38, off: 32, c: "danger"  },
            { label: "  redis.set",      w: 4,  off: 88, c: "muted"   },
          ].map((s) => (
            <div class="flex items-center gap-2">
              <span class="w-32 text-text-muted truncate">{s.label}</span>
              <div class="flex-1 relative h-3 bg-surface-3 rounded-sm overflow-hidden">
                <span
                  class={`absolute top-0 bottom-0 rounded-sm ${s.c === "brand" ? "bg-brand" : s.c === "warning" ? "bg-warning" : s.c === "danger" ? "bg-danger" : "bg-text-muted/60"}`}
                  style={`left:${s.off}%;width:${s.w}%`}
                ></span>
              </div>
            </div>
          ))}
        </div>
      </article>

      <!-- SMALL: logs -->
      <article class="reveal sm:col-span-3 rounded-2xl border border-border-subtle bg-surface-2 p-6 relative overflow-hidden">
        <div class="flex items-center gap-2 font-mono text-[11px] tracking-widest uppercase text-text-muted mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-warning"></span>
          logs
        </div>
        <h3 class="text-[18px] font-semibold tracking-tight mb-3">Recent errors. Tail-style.</h3>
        <div class="space-y-1 font-mono text-[10.5px] leading-relaxed">
          <div class="text-text-muted">
            <span class="text-text-muted">21:04:18</span>
            <span class="text-danger">ERROR</span>
            payments-worker: stripe.charge timeout after 30s
          </div>
          <div class="text-text-muted">
            <span class="text-text-muted">21:04:17</span>
            <span class="text-warning">WARN</span>
            checkout-svc: retry 2/3 on tax-api
          </div>
          <div class="text-text-muted">
            <span class="text-text-muted">21:04:15</span>
            <span class="text-danger">ERROR</span>
            payments-worker: stripe.charge timeout after 30s
          </div>
          <div class="text-text-muted">
            <span class="text-text-muted">21:04:11</span>
            <span class="text-success">INFO</span>
            api-gateway: ready · pid 24187
          </div>
        </div>
      </article>

      <!-- SMALL: push alerts -->
      <article class="reveal sm:col-span-3 rounded-2xl border border-border-subtle bg-surface-2 p-6 relative overflow-hidden">
        <div class="flex items-center gap-2 font-mono text-[11px] tracking-widest uppercase text-text-muted mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-danger pulse-dot"></span>
          push alerts
        </div>
        <h3 class="text-[18px] font-semibold tracking-tight mb-2">Alertmanager &rarr; your pocket.</h3>
        <p class="text-text-secondary text-[13px] leading-relaxed mb-4">
          A Cloudflare Worker relay turns SigNoz alerts into Expo push notifications.
          HMAC-signed. No third-party broker.
        </p>
        <!-- Fake notification preview -->
        <div class="rounded-xl border border-border bg-surface px-3.5 py-2.5 flex items-start gap-3 shadow-[0_8px_24px_-12px_rgba(0,0,0,0.5)]">
          <div class="w-8 h-8 rounded-md bg-brand flex items-center justify-center text-white font-mono text-[12px] flex-shrink-0">§</div>
          <div class="min-w-0">
            <div class="text-[12px] font-semibold truncate">SigPocket · prod</div>
            <div class="text-[11.5px] text-text-secondary leading-snug">
              payments-worker error rate <span class="font-mono text-danger">6.4%</span> for 5m
            </div>
          </div>
          <div class="font-mono text-[10px] text-text-muted whitespace-nowrap">now</div>
        </div>
      </article>

      <!-- SMALL: multi-instance / keychain -->
      <article class="reveal sm:col-span-2 rounded-2xl border border-border-subtle bg-surface-2 p-6 relative overflow-hidden">
        <div class="flex items-center gap-2 font-mono text-[11px] tracking-widest uppercase text-text-muted mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-text-muted"></span>
          instances
        </div>
        <h3 class="text-[18px] font-semibold tracking-tight mb-2">Switch stacks fast.</h3>
        <p class="text-text-secondary text-[13px] leading-relaxed">
          Prod, staging, that side-project cluster. Credentials live in the device keychain.
        </p>
        <div class="mt-4 space-y-1.5">
          <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-surface border border-brand/50">
            <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
            <span class="font-mono text-[11px] flex-1">prod-us-east</span>
            <span class="font-mono text-[10px] text-text-muted">active</span>
          </div>
          <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-surface border border-border-subtle">
            <span class="w-1.5 h-1.5 rounded-full bg-text-muted"></span>
            <span class="font-mono text-[11px] flex-1 text-text-secondary">staging</span>
          </div>
          <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-surface border border-border-subtle">
            <span class="w-1.5 h-1.5 rounded-full bg-text-muted"></span>
            <span class="font-mono text-[11px] flex-1 text-text-secondary">homelab</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ─── PRIVACY ──────────────────────────────────────────── -->
  <section class="relative mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
    <SectionAnchor id="privacy" label="Privacy" index="03 · the honest part" />

    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] items-start">
      <div class="reveal">
        <h2 class="text-[34px] sm:text-[48px] font-semibold tracking-tight leading-[1]">
          We don't see your data.
          <span class="text-text-muted">We don't want to.</span>
        </h2>
        <p class="mt-5 text-[16px] text-text-secondary leading-relaxed max-w-xl">
          SigPocket is a client, not a service. It connects directly to the SigNoz
          instance you configure. There is no SigPocket backend, no SigPocket account,
          no SigPocket telemetry pipeline.
        </p>
        <p class="mt-4 text-[15px] text-text-secondary leading-relaxed max-w-xl">
          The app's own telemetry (cold starts, screen loads, API timings) is
          OTLP-formatted and sent to <em class="text-text not-italic font-mono text-[13px] bg-surface-2 px-1.5 py-0.5 rounded-md border border-border-subtle">your</em> SigNoz, so you can see how the app behaves
          alongside the services it monitors.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/privacy" class="inline-flex items-center gap-2 h-10 px-4 rounded-lg border border-border bg-surface-2 text-[13px] font-medium hover:bg-surface-3 transition-colors">
            Read the privacy page
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="https://github.com/eknuth/sigpocket" target="_blank" rel="noopener" class="inline-flex items-center gap-2 h-10 px-4 rounded-lg font-mono text-[12px] text-text-secondary hover:text-text transition-colors">
            verify the source &rarr;
          </a>
        </div>
      </div>

      <div class="reveal">
        <ul class="space-y-3 font-mono text-[13px]">
          {[
            ["no accounts",          "no signup, no email, no SSO"],
            ["no analytics",         "no GA, no Segment, no Posthog"],
            ["no tracking",          "no ad SDKs, no third-party SDKs"],
            ["keychain credentials", "API keys live in Expo SecureStore"],
            ["BYO telemetry",        "self-traces go to your SigNoz"],
            ["apache 2.0",           "audit, fork, rehost. yours."],
          ].map(([k, v]) => (
            <li class="flex items-start gap-4 px-4 py-3 rounded-lg border border-border-subtle bg-surface-2">
              <span class="text-brand mt-[1px]" aria-hidden="true">→</span>
              <div class="flex-1">
                <div class="text-text">{k}</div>
                <div class="text-[12px] text-text-muted">{v}</div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── TECH STACK STRIP ─────────────────────────────────── -->
  <section id="stack" class="relative border-y border-border-subtle bg-surface overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-8 sm:py-10">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-[12px] text-text-muted">
        <span class="text-text-secondary tracking-widest uppercase text-[10px]">§ stack</span>
        {[
          "expo",
          "react-native",
          "victory-native",
          "skia",
          "react-query",
          "zustand",
          "expo-secure-store",
          "cloudflare-workers",
          "open-telemetry",
          "signoz-api · v2/v3",
        ].map((s, i) => (
          <span class="flex items-center gap-x-6">
            <span class="hover:text-text transition-colors">{s}</span>
            {i < 9 && <span class="opacity-30">·</span>}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── GET STARTED ──────────────────────────────────────── -->
