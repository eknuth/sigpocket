---
// CSS-drawn phone showcasing the SigPocket services list.
// Stand-in for a real screenshot; rendered as HTML so it scales crisp on any DPR.
---

<div class="phone-mock relative mx-auto" aria-hidden="true">
  <div class="phone-frame">
    <div class="phone-notch"></div>

    <div class="phone-screen">
      <!-- Status bar -->
      <div class="phone-status">
        <span class="font-mono text-[10px] tracking-tight tabular text-text">9:41</span>
        <div class="flex items-center gap-1">
          <span class="w-3 h-1.5 rounded-[1px] border border-text/60"></span>
          <span class="w-3 h-1.5 rounded-[1px] border border-text/60"></span>
          <span class="w-4 h-1.5 rounded-sm bg-text/85"></span>
        </div>
      </div>

      <!-- Header -->
      <div class="px-4 pt-3 pb-3 flex items-end justify-between">
        <div>
          <div class="font-mono text-[9px] tracking-widest uppercase text-text-muted">prod · us-east-1</div>
          <div class="text-[20px] font-semibold tracking-tight text-text mt-0.5">Services</div>
        </div>
        <div class="text-[10px] font-mono tabular text-text-muted leading-tight">
          <div>last 1h</div>
          <div class="text-success">live</div>
        </div>
      </div>

      <!-- Service rows -->
      <div class="px-3 space-y-1.5">
        <!-- 1: healthy -->
        <div class="service-row">
          <div class="row-dot" style="background:var(--success)"></div>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-medium text-text truncate">api-gateway</div>
            <div class="font-mono text-[10px] tabular text-text-muted">1.28k req/min</div>
          </div>
          <div class="row-metric">
            <div class="font-mono text-[11px] tabular text-text">184<span class="text-text-muted text-[9px]">ms</span></div>
            <div class="font-mono text-[9px] tabular text-success">0.04%</div>
          </div>
        </div>
        <!-- 2: warn -->
        <div class="service-row">
          <div class="row-dot" style="background:var(--warning)"></div>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-medium text-text truncate">checkout-svc</div>
            <div class="font-mono text-[10px] tabular text-text-muted">412 req/min</div>
          </div>
          <div class="row-metric">
            <div class="font-mono text-[11px] tabular text-text">521<span class="text-text-muted text-[9px]">ms</span></div>
            <div class="font-mono text-[9px] tabular text-warning">1.21%</div>
          </div>
        </div>
        <!-- 3: critical -->
        <div class="service-row critical">
          <div class="row-dot" style="background:var(--danger);box-shadow:0 0 12px var(--danger)"></div>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-medium text-text truncate">payments-worker</div>
            <div class="font-mono text-[10px] tabular text-text-muted">88 req/min</div>
          </div>
          <div class="row-metric">
            <div class="font-mono text-[11px] tabular text-danger">2.1<span class="text-text-muted text-[9px]">s</span></div>
            <div class="font-mono text-[9px] tabular text-danger">6.4%</div>
          </div>
        </div>
        <!-- 4: healthy -->
        <div class="service-row">
          <div class="row-dot" style="background:var(--success)"></div>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-medium text-text truncate">user-service</div>
            <div class="font-mono text-[10px] tabular text-text-muted">2.04k req/min</div>
          </div>
          <div class="row-metric">
            <div class="font-mono text-[11px] tabular text-text">61<span class="text-text-muted text-[9px]">ms</span></div>
            <div class="font-mono text-[9px] tabular text-success">0.01%</div>
          </div>
        </div>
        <!-- 5: healthy -->
        <div class="service-row">
          <div class="row-dot" style="background:var(--success)"></div>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-medium text-text truncate">notify-relay</div>
            <div class="font-mono text-[10px] tabular text-text-muted">96 req/min</div>
          </div>
          <div class="row-metric">
            <div class="font-mono text-[11px] tabular text-text">38<span class="text-text-muted text-[9px]">ms</span></div>
            <div class="font-mono text-[9px] tabular text-success">0%</div>
          </div>
        </div>
        <!-- 6: healthy -->
        <div class="service-row">
          <div class="row-dot" style="background:var(--success)"></div>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-medium text-text truncate">search-index</div>
            <div class="font-mono text-[10px] tabular text-text-muted">324 req/min</div>
          </div>
          <div class="row-metric">
            <div class="font-mono text-[11px] tabular text-text">112<span class="text-text-muted text-[9px]">ms</span></div>
            <div class="font-mono text-[9px] tabular text-success">0.08%</div>
          </div>
        </div>
      </div>

      <!-- Floating tab bar -->
      <div class="phone-tabbar">
        <div class="tab-item active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12L12 4l9 8M5 10v10h14V10"/></svg>
          <span>services</span>
        </div>
        <div class="tab-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6"/><path d="m20 20-3-3"/></svg>
          <span>traces</span>
        </div>
        <div class="tab-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h16"/></svg>
          <span>logs</span>
        </div>
        <div class="tab-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06A2 2 0 1 1 4.27 16.96l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.6.21 1 .78 1 1.41V11a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>settings</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Glow behind device -->
  <div class="phone-glow"></div>
</div>

<style>
  .phone-mock {
    width: clamp(240px, 28vw, 320px);
    aspect-ratio: 9 / 19;
    position: relative;
    isolation: isolate;
  }
  .phone-glow {
    position: absolute;
    inset: -10% -20% -20% -20%;
    background: radial-gradient(ellipse at 60% 35%, var(--brand-glow) 0%, transparent 55%);
    filter: blur(20px);
    z-index: -1;
    pointer-events: none;
  }
  .phone-frame {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #1d2029, #0a0b0e);
    border-radius: 36px;
    padding: 6px;
    box-shadow:
      0 0 0 1px #2c3140 inset,
      0 30px 60px -20px rgba(0,0,0,0.75),
      0 0 0 0.5px rgba(255,255,255,0.04);
  }
  .phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 26%;
    height: 18px;
    background: #000;
    border-radius: 999px;
    z-index: 2;
  }
  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--bg);
    border-radius: 30px;
    overflow: hidden;
  }
  .phone-status {
    height: 28px;
    padding: 8px 18px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .service-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    background: var(--surface-2);
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }
  .service-row.critical {
    border-color: color-mix(in srgb, var(--danger) 40%, var(--border));
    box-shadow: 0 0 14px -4px color-mix(in srgb, var(--danger) 28%, transparent);
  }
  .row-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .row-metric {
    text-align: right;
    line-height: 1.1;
  }
  .phone-tabbar {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 14px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface-float);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 6px;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px -8px rgba(0,0,0,0.5);
  }
  .tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 5px 0;
    font-family: var(--font-sans);
    font-size: 8px;
    color: var(--text-muted);
    border-radius: 14px;
  }
  .tab-item svg {
    width: 14px;
    height: 14px;
  }
  .tab-item.active {
    background: color-mix(in srgb, var(--brand) 18%, transparent);
    color: var(--brand-hi);
  }
</style>
