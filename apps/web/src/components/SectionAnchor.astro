---
interface Props {
  id?: string;
  label: string;
  index?: string;
}
const { id, label, index } = Astro.props;
---

<div id={id} class="flex items-center gap-3 mb-8 sm:mb-10 reveal">
  <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-sm border border-border bg-surface-2 font-mono text-[11px] tracking-[0.2em] uppercase text-text-secondary">
    <span aria-hidden="true" class="text-brand">§</span>
    {label}
  </span>
  {index && (
    <span class="font-mono text-[11px] text-text-muted tabular">
      {index}
    </span>
  )}
  <span class="flex-1 h-px bg-border-subtle"></span>
</div>
